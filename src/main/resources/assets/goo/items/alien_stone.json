{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "material",
    "cases": [
      {
        "when": "glazed",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_stone_glazed"
        }
      },
      {
        "when": "iridescent",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_stone_iridescent"
        }
      },
      {
        "when": "faceted",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_stone_faceted"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "goo:block/alien_stone_glazed"
    }
  }
}
