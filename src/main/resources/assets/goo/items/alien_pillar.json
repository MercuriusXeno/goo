{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "style",
    "cases": [
      {
        "when": "fluted",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_pillar_fluted"
        }
      },
      {
        "when": "banded",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_pillar_banded"
        }
      },
      {
        "when": "runed",
        "model": {
          "type": "minecraft:model",
          "model": "goo:block/alien_pillar_runed"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "goo:block/alien_pillar_fluted"
    }
  }
}
