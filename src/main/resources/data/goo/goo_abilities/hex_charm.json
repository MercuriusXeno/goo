{
  "gooType": "hex",
  "displayName": "goo.ability.hex.charm",
  "badge": "mob",
  "order": 0,
  "cost": 1000,
  "requires": ["minecraft:honey_bottle", "minecraft:cake", "minecraft:cookie"],
  "delivery": { "kind": "envelop" },
  "behaviors": [
    {
      "type": "target",
      "where": ["mob", "not_boss"],
      "steps": [
        {
          "type": "branch",
          "when": "chance(pow(20 / max_health, 1.5))",
          "then": [
            { "type": "charm" }
          ],
          "otherwise": [
            { "type": "particles", "id": "minecraft:smoke", "at": "target", "count": 12, "spread": 0.3, "speed": 0.02, "lift": 0.5 },
            { "type": "sound", "id": "minecraft:block.fire.extinguish", "at": "target", "source": "players", "volume": 0.6, "pitch": 1.0 },
            { "type": "envelop_burst" }
          ]
        }
      ]
    }
  ],
  "tags": ["entity"]
}
