{
  "gooType": "aeon",
  "displayName": "goo.ability.aeon.time_stop",
  "order": 0,
  "cost": {
    "formula": "quadratic",
    "baseCost": 1000,
    "a": 0.0,
    "b": 1.0,
    "c": 1.0
  },
  "behaviors": [
    {
      "type": "program",
      "steps": [
        {
          "type": "target",
          "where": ["mob"],
          "steps": [
            { "type": "counter", "id": "goo:ritual", "add": "100 / pow(max_health, 0.6)" },
            {
              "type": "branch",
              "when": "at_least(goo:ritual, 100)",
              "then": [
                {
                  "type": "target",
                  "where": ["has_baby_form", "not_baby"],
                  "steps": [
                    { "type": "set_baby", "enabled": true },
                    { "type": "counter", "id": "goo:ritual", "set": 0 }
                  ]
                }
              ]
            },
            {
              "type": "branch",
              "when": "at_least(goo:ritual, 100)",
              "then": [
                { "type": "drop_item", "item": "spawn_egg", "count": 1 },
                { "type": "discard" }
              ],
              "otherwise": [
                { "type": "set_ai", "enabled": false },
                { "type": "set_invulnerable", "enabled": true },
                { "type": "potion", "effect": "minecraft:glowing", "duration": 60, "amplifier": 0 }
              ]
            }
          ]
        }
      ]
    }
  ],
  "tags": ["entity"]
}
